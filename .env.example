# NVIDIA NIM (OpenAI-compatible /v1/chat/completions endpoint)
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-bolt-e4b
# Either NIM_API_KEY or NVIDIA_API_KEY can be used for NVIDIA.
NIM_API_KEY=
# NVIDIA_API_KEY=

# Nebius Token Factory (optional; takes precedence over NIM when configured)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=
NEBIUS_API_KEY=

# Tavily web verification
TAVILY_API_KEY=

# Optional custom path for recipes and append-only state transaction log
ORCHESTRATOR_RECIPES_DIR=./recipes
ORCHESTRATOR_STATE_LOG=./.orchestrator_state.jsonl
