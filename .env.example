# AI provider: `nebius` (production) or `nim` (testing).
# Leave blank to use Nebius when NEBIUS_API_KEY is set, otherwise NVIDIA NIM.
# Each provider uses one fixed model built into SetupPal; there is no model setting.
SETUPPAL_PROVIDER=

# Nebius Token Factory (production)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_API_KEY=

# NVIDIA NIM (testing; OpenAI-compatible /v1/chat/completions endpoint)
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Either NIM_API_KEY or NVIDIA_API_KEY can be used for NVIDIA.
NIM_API_KEY=
# NVIDIA_API_KEY=

# Tavily web verification
TAVILY_API_KEY=

# Optional custom path for recipes and append-only state transaction log
ORCHESTRATOR_RECIPES_DIR=./recipes
ORCHESTRATOR_STATE_LOG=./.orchestrator_state.jsonl
