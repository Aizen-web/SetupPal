# NVIDIA NIM Configuration (OpenAI-compatible /v1/chat/completions endpoint)
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-bolt-e4b
NIM_API_KEY=nvapi-REPLACE_WITH_YOUR_KEY

# Optional custom path for recipes and append-only state transaction log
ORCHESTRATOR_RECIPES_DIR=./recipes
ORCHESTRATOR_STATE_LOG=./.orchestrator_state.jsonl
