# Nebius Token Factory only. Optional; leave blank or set to `nebius`.
SETUPPAL_PROVIDER=

# Optional Nemotron model slug: lightning | super (default) | ultra
# Exact Nebius API IDs are also accepted. Unknown values are ignored (Super is used).
SETUPPAL_MODEL=super

# Nebius Token Factory (required for chat and planning)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_API_KEY=

# Tavily web verification (Safety Engine source-domain consensus only)
TAVILY_API_KEY=

# Optional custom path for recipes and append-only state transaction log
ORCHESTRATOR_RECIPES_DIR=./recipes
ORCHESTRATOR_STATE_LOG=./.orchestrator_state.jsonl
